{
  "name": "@elite-truck/publishing-fixture-sdk",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/sdk/src/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "bun run build",
    "build": "bun build src/index.ts --target=node --outfile dist/index.js && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "typescript": "^5.9.3"
  }
}
